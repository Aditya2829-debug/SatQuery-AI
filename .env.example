SATQUERY_ENV=development
SATQUERY_LOG_LEVEL=INFO
SATQUERY_CONFIG=configs/base.yaml
SATQUERY_DEVICE=auto
SATQUERY_MODEL_CACHE=./models/cache
SATQUERY_DATA_ROOT=./data
# Optional external model/API credentials. Never commit real secrets.
HF_TOKEN=
# Model inference paths (export into the worker environment; no weights in Git)
SATQUERY_MODEL1_ADAPTER=
SATQUERY_MODEL2_CHECKPOINT=
SATQUERY_MODEL2_INDEX=
